# Copy this file to .env and fill it in. Never commit .env or paste keys into code or chat.
OPENAI_API_KEY=
# Optional: stops strangers from using your API key once the backend is online.
# If you set it here, set the same value as API_TOKEN in extension/background.js
EXTENSION_TOKEN=



# Optional: change the models
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Optional: send the server-side caption requests through a proxy if YouTube blocks your IP
# TRANSCRIPT_PROXY_URL=http://user:pass@host:port
